# NCP(네이버 클라우드 플랫폼) Maps > Application Client ID
# 콘솔: https://console.ncloud.com > AI·NAVER API > Application 등록 > Maps 서비스 선택
# ⚠️ 등록한 Application의 "Web 서비스 URL"에 localhost:3000(개발) / 실제 배포 도메인이 등록돼 있어야
#    지도가 뜬다. 등록 안 돼 있으면 콘솔에 인증 에러가 뜨면서 지도가 비어 보인다.
NEXT_PUBLIC_NAVER_MAP_CLIENT_ID=

# ── F7 "내 주변 맛집" (PRD v0.2 §4.6) ─────────────────────────────
# 카카오 개발자 콘솔(https://developers.kakao.com) > 내 애플리케이션 > 앱 키
#
# REST API 키 — 서버 프록시(/api/nearby)에서만 쓴다. NEXT_PUBLIC_ 접두사를 절대 붙이지 않는다
# (클라이언트에 노출되면 §13 리스크 "카카오 REST 키 유출"). 없으면 목데이터로 자동 폴백한다.
KAKAO_REST_API_KEY=

# JavaScript 키 — F7 지도(카카오맵 JS SDK)용. 앱의 "플랫폼 > Web" 사이트 도메인에
# localhost:3000(개발) / 실제 배포 도메인을 등록해야 지도가 뜬다. 없으면 키 없이 되는
# Esri 위성 타일로 자동 폴백한다(components/NearbyMap.tsx).
NEXT_PUBLIC_KAKAO_MAP_JS_KEY=

# ── F4 확장 "구글 리뷰" ────────────────────────────────────────────
# Google Cloud Console(https://console.cloud.google.com) > 프로젝트 선택 >
# API 및 서비스 > 라이브러리 > "Places API (New)" 활성화 후 API 키 발급.
#
# 서버 라우트(/api/reviews)에서만 쓴다. NEXT_PUBLIC_ 접두사를 절대 붙이지 않는다
# (클라이언트에 노출되면 안 됨 — KAKAO_REST_API_KEY와 동일한 이유). 없으면 상세
# 페이지의 리뷰 패널이 에러 상태로 표시된다(components/ReviewPanel.tsx).
GOOGLE_PLACES_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
